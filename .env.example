# Banco de dados (contêiner MySQL)
DB_HOST=db
DB_PORT=3306
DB_USER=cineaxes
DB_PASS=cineaxes123
DB_NAME=cineaxes


# Portas expostas pelo docker-compose.yml
# App (Apache + PHP) -> http://localhost:8080
# phpMyAdmin         -> http://localhost:8081
# MySQL              -> localhost:3308 (interno 3306)
#
# Copie este arquivo para .env antes de subir os serviços:
#   cp .env.example .env
#
# Tokens/segredos (ex.: TOKEN_GITHUB) devem ficar somente no .env, que não é versionado.
