# Banco de dados (contêiner MySQL)
DB_HOST=db
DB_PORT=3306
DB_USER=personacut
DB_PASS=personacut123
DB_NAME=personacut

# Aplicação
APP_DEBUG=true

# TMDB (opcional — usada no enriquecimento de fotos, fichas e cenas)
# https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Groq (opcional — retrato do perfil redigido por IA)
# https://console.groq.com/keys
GROQ_API_KEY=
# Modelo de chat (deixe vazio para usar o padrão do config/app.php)
GROQ_MODEL=
# Modelo de transcrição (reservado para perguntas por voz)
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# Portas expostas pelo docker-compose.yml
# App (Apache + PHP) -> http://localhost:8090
# phpMyAdmin         -> http://localhost:8091
# MySQL              -> localhost:3308 (interno 3306)
#
# Copie este arquivo para .env antes de subir os serviços:
#   cp .env.example .env
#
# Tokens/segredos (TMDB_API_KEY, senhas) devem ficar somente no .env,
# que não é versionado.
